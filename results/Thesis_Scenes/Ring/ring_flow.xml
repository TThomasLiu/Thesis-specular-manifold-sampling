<scene version="2.0.0">
    <default name="spp" value="32"/>
    <default name="crop_offset_x" value="0"/>
    <default name="crop_offset_y" value="0"/>
    <default name="crop_width" value="1920"/>
    <default name="crop_height" value="1080"/>

    <default name="light_angle" value="0"/>

    <default name="block_size" value="1024"/>
    <default name="samples_per_pass" value="4294967295"/>   <!-- == ((size_t) -1) -->
    <default name="timeout" value="-1.0"/>

    <default name="remove_pt_direct_hit"             value="true"/>

    <default name="model_device"                    value="gpu"/>
    <default name="visnet_enable"                   value="true"/>
    <default name="visnet_threshold"                value="0.4"/>
    <default name="rmax"                            value="1.5"/>
    <default name="noise_std"                       value="0.01"/>
    <default name="photon_mode"                     value="true"/>

    <default name="caustics_bounces"                value="1"/>


    <integrator type="path_flow_ms">
        <integer name="max_depth" value="8"/>
        <integer name="samples_per_pass" value="$samples_per_pass"/>
        <integer name="block_size" value="$block_size"/>
        <float name="timeout" value="$timeout"/>

        <integer name="bounces"                 value="$caustics_bounces"/>
        <boolean name="remove_pt_direct_hit"    value="$remove_pt_direct_hit"/>

        <string  name="model_device"             value="$model_device"/>
        <boolean name="visnet_enable"            value="$visnet_enable"/>
        <float   name="visnet_threshold"         value="$visnet_threshold"/>
        <float   name="rmax"                     value="$rmax"/>
        <float   name="noise_std"                value="$noise_std"/>
        <boolean   name="photon_mode"                value="$photon_mode"/>

    </integrator>

    <shape type="obj" id="target_obj">
        <boolean name="caustic_caster_multi" value="true"/>
        <string name="visnet_model_path" value="model/ring_far5_visnet2_3L_32h_test_1_vis.pt"/>
        <string name="flow_model_path" value="model/ring_din_disk_20L_h256_b1_far5_nerfflow2_normoffset_inputskip_noise001_fm.pt"/>
        <!-- <string name="flow_model_path" value="model/ring_din_disk_20L_h256_b1_far5_nerfflow2_noise0005_fm.pt"/> -->
        <!-- <string name="flow_model_path" value="model/ring_din_disk_20L_h256_b1_far5_nerfflow3_noise001_fm.pt"/> -->
        <transform name="to_world">
            
            <!-- <rotate x="1" angle="10"/> -->
            <!-- <translate x="0" y="-0.96" z="0"/> -->
            <translate x="0" y="0.125" z="0"/>
        </transform>
        <string name="filename" value="meshes/ring.obj"/>

        <bsdf type="conductor">
            <string name="material" value="Au"/>
        </bsdf>
    </shape>

    <shape type="obj">
        <string name="filename" value="meshes/floor.obj" />
        <boolean name="caustic_receiver" value="true"/>

        <bsdf type="diffuse">
            <spectrum name="reflectance" type="bitmap">
                <!-- <string name="filename" value="textures/[2K]Wood30/Wood030_2K_Color.jpg"/> -->
                <string name="filename" value="textures/[2K]Tiles71/Tiles71_col.jpg"/>

                <transform name="to_uv">
                    <scale x="10" y="10"/>
                </transform>
            </spectrum>
        </bsdf>
    </shape>

    <shape type="obj">
        <string name="filename" value="meshes/light.obj" />

        <emitter type="area">
            <spectrum name="radiance" value="5000"/>
            <boolean name="caustic_emitter_multi" value="true"/>
        </emitter>

        <transform name="to_world">
            <rotate y="1" angle="90"/>
            <translate x="0" y="0" z="0.1"/>
            <rotate x="0.0" y="1.0" z="0.0" angle="$light_angle"/>
        </transform>
    </shape>
    
    <!-- <emitter type="point">
        <spectrum name="intensity" value="50"/>
        <point name="position" value="-1.8, 1, 0"/>
        <boolean name="caustic_emitter_multi" value="true"/>
    </emitter> -->
    <film type="hdrfilm" id="film">
            <integer name="width" value="1024"/>
            <integer name="height" value="1024"/>
            <rfilter type="gaussian"/>

            <!-- <integer name="crop_offset_x" value="$crop_offset_x"/>
            <integer name="crop_offset_y" value="$crop_offset_y"/>
            <integer name="crop_width" value="$crop_width"/>
            <integer name="crop_height" value="$crop_height"/> -->
        </film>
    <sampler type="independent" id="sampler">
        <integer name="sample_count" value="$spp" />
    </sampler>

    <sensor type="perspective">
        <string name="fov_axis" value="smaller"/>
        <float name="fov" value="39.597752"/>

        <transform name="to_world">
            <rotate x="0.0" y="1.0" z="0.0" angle="180.00"/>
            <rotate x="1.0" y="0.0" z="0.0" angle="-60"/>
            <rotate x="0.0" y="1.0" z="0.0" angle="57.07"/>
            <rotate x="0.0" y="0.0" z="1.0" angle="-0.73"/>
            <translate x="2.009096" y="3.606013" z="1"/>
        </transform>
        
        <!-- <transform name="to_world">
            <rotate x="0.0" y="1.0" z="0.0" angle="180.00"/>
            <rotate x="1.0" y="0.0" z="0.0" angle="-39.58"/>
            <rotate x="0.0" y="1.0" z="0.0" angle="57.07"/>
            <rotate x="0.0" y="0.0" z="1.0" angle="-0.73"/>
            <translate x="3.009096" y="3.606013" z="2.395111"/>
        </transform> -->

        <ref id="sampler"/>
        <ref id="film"/>
    </sensor>
</scene>
